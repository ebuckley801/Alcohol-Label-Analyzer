# Vision provider: azure_ai_vision (recommended) or azure_openai (fallback)
VISION_PROVIDER=azure_ai_vision

# Azure AI Vision (OCR)
AZURE_AI_VISION_ENDPOINT=https://your-vision-resource.cognitiveservices.azure.com
# Optional when using Managed Identity in Azure; required for local key auth
AZURE_AI_VISION_KEY=

# Azure OpenAI fallback (used only when VISION_PROVIDER=azure_openai)
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional test toggle
SIMULATE_TRANSIENT_FAILURE=false

# Optional fallback when deterministic location parsing is ambiguous
ENABLE_COUNTRY_AI_FALLBACK=false

# Optional OpenAI core-data fallback when using VISION_PROVIDER=azure_ai_vision
ENABLE_OPENAI_CORE_FALLBACK=false
OPENAI_CORE_FALLBACK_ON_MISSING_CORE_DATA=true
OPENAI_CORE_FALLBACK_ON_LOW_CONFIDENCE=true
OPENAI_CORE_FALLBACK_ON_SIZE_HEURISTIC=true
OPENAI_CORE_FALLBACK_ON_UNKNOWN_CLASS_TYPE=true

# Optional local OCR debug dump (append-only NDJSON for test runs)
LOCAL_OCR_DUMP_ENABLED=false
LOCAL_OCR_DUMP_PATH=local_debug/ocr_text.ndjson
